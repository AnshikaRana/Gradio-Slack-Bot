# Copy this file to .env and paste your own Slack tokens (never commit .env)

# OAuth & Permissions -> "Bot User OAuth Token"
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Basic Information -> App-Level Tokens (created when enabling Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token

# Which Gradio app the bot talks to:
#  - the Hugging Face Space used in the Gradio guide (default), or
#  - your own local app from gradio_app.py:  http://127.0.0.1:7860/
GRADIO_APP=http://127.0.0.1:7860/
# (the guide used the Space abidlabs/gradio-playground-bot, which currently returns errors)

# Only used by gradio_app.py (local Ollama model)
OLLAMA_MODEL=llama3.2:3b
